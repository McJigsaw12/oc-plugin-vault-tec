{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-plugin-vault-tec-mcjigsaw",
  "version": "0.4.0",
  "description": "Vault-Tec theme, personality and Pip-Boy sidebar for OpenCode V2 (fork of kommander/oc-plugin-vault-tec).",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-v2",
    "vault-tec",
    "fallout",
    "tui",
    "plugin",
    "theme",
    "terminal"
  ],
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McJigsaw12/oc-plugin-vault-tec.git"
  },
  "homepage": "https://github.com/McJigsaw12/oc-plugin-vault-tec#readme",
  "bugs": {
    "url": "https://github.com/McJigsaw12/oc-plugin-vault-tec/issues"
  },
  "exports": {
    "./server": {
      "import": "./server.ts",
      "config": {
        "enabled": true,
        "mode": "append",
        "install_theme": true,
        "set_theme": true,
        "theme": "vault-tec",
        "theme_mode": "dark",
        "overwrite_theme": true
      }
    },
    "./tui": {
      "import": "./tui.tsx",
      "config": {
        "enabled": true,
        "sidebar": true
      }
    }
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "devDependencies": {
    "oxfmt": "0.41.0"
  },
  "peerDependencies": {
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  }
}
